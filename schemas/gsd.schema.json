{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSDConfig",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "pipelines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["parallel", "series"]
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["tasks"]
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "restartOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interval": {
            "type": "string"
          }
        },
        "required": ["command"]
      }
    }
  },
  "required": ["project", "pipelines", "tasks"]
}
